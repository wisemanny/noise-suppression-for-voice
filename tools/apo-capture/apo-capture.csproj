<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>apo-capture</AssemblyName>
    <RootNamespace>ApoCapture</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 2.2.1 is the last release that targets netstandard2.0/net6.0;
         NAudio 3.x requires .NET 9. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
